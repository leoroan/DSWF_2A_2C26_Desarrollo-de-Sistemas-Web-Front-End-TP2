# Clave de la API REST Countries v5.
#
# OBTENLA en https://restcountries.com/ (registro gratuito) y guardala en tu
# archivo local .env, que NO se sube al repositorio (está en .gitignore).
#
# IMPORTANTE: las variables VITE_* de Vite se incrustan en el bundle del
# navegador. Esta clave es de uso público del frontend, NO es un secreto real.
# Nunca subas una clave privada al repositorio.
VITE_REST_COUNTRIES_API_KEY=rc_live_demo
