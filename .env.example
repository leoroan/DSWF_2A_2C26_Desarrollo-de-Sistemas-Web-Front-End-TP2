# Copiar a .env.local y completar solo en el entorno local.
# En Vercel, crear estas mismas variables en la configuración del proyecto.
# Nunca usar el prefijo VITE_ para estas claves privadas.
REST_COUNTRIES_API_KEY=
# Clave de Unsplash para las fotos de ciudad de cada perfil.
# Obtenerla en https://unsplash.com/developers (cuenta gratuita).
UNSPLASH_ACCESS_KEY=
